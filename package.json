{
  "name": "ankui",
  "version": "0.2.2",
  "description": "Local-first TUI/CLI for inspecting AI coding tool configurations.",
  "type": "module",
  "bin": {
    "ankui": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:web": "vite",
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc -p tsconfig.json",
    "build:web": "tsc -p src/web-ui/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web-ui/tsconfig.json",
    "test": "node --import tsx --test test/scanner/*.test.ts test/scanner/adapters/*.test.ts test/utils/*.test.ts test/commands/*.test.ts test/config/*.test.ts test/tui/*.test.ts test/tui/*.test.tsx test/tui/**/*.test.ts test/tui/**/*.test.tsx test/writer/*.test.ts test/bundles/*.test.ts test/web/*.test.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "tui",
    "mcp",
    "agents"
  ],
  "author": "Mert Cetin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merttcetn/ankui.git"
  },
  "homepage": "https://github.com/merttcetn/ankui#readme",
  "bugs": {
    "url": "https://github.com/merttcetn/ankui/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fuse.js": "^7.1.0",
    "ink": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "react": "^18.3.1",
    "smol-toml": "^1.3.4",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "ink-testing-library": "^4.0.0",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.21"
  }
}
