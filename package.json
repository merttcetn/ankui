{
  "name": "ankui",
  "version": "0.0.0",
  "description": "Local-first TUI/CLI for inspecting AI coding tool configurations.",
  "type": "module",
  "bin": {
    "ankui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/scanner/*.test.ts test/utils/*.test.ts test/commands/*.test.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "ai",
    "cli",
    "tui",
    "mcp",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.14",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fuse.js": "^7.1.0",
    "ink": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "react": "^18.3.1",
    "smol-toml": "^1.3.4",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
